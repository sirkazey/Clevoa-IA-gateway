# Docker Desktop : cp .env.example .env ; docker compose -f docker-compose.dev.yml up -d --build (hub + bouchon) ; http://localhost:8080
# Avec le bouchon, seules ENCRYPTION_KEY et PUBLIC_URL sont nécessaires : chaque variable renseignée ci-dessous rebranche un vrai système.
# RÈGLE : jamais de commentaire sur la même ligne qu'une valeur vide (Docker Compose le lirait comme la valeur).
# Une variable VIDE garde la valeur par défaut du fichier Compose (ex. le bouchon en pré-prod) : pour quitter le bouchon, renseigner la vraie valeur.

# Ouvrir le portail EXACTEMENT à cette adresse (le cookie et les callbacks OAuth y sont liés)
PUBLIC_URL=http://localhost:8080
# OBLIGATOIRE : openssl rand -hex 32 ; chiffre users.json (AES-256-GCM). À sauvegarder : perdue = jetons illisibles
ENCRYPTION_KEY=
# preprod (défaut) ou production (https obligatoire) ; docker-compose.dev.yml et .prod.yml imposent leur propre valeur, celle-ci ne vaut que pour docker-compose.yml seul
APP_ENV=preprod
# info ou debug (trace des appels d'outils) ; même remarque, dev = debug et prod = info sont imposés par les stacks
LOG_LEVEL=info
# nombre de reverse-proxys devant le hub
TRUST_PROXY=1
# instance (multi-client) : nom du serveur MCP annoncé aux assistants et clé du bloc mcpServers du portail (défaut clevoa-gateway ;
# lettres, chiffres, tirets, soulignés), et libellé affiché sur le portail (vide = Clevoa AI Gateway). Ex. charlois-finance / MCP Charlois
MCP_SERVER_NAME=
INSTANCE_LABEL=
# port publié du hub ; derrière le nginx du profil proxy : 127.0.0.1:8080 (joignable par nginx seulement)
HUB_PORT=8080
# sauvegarde automatique quotidienne de users.json (chiffré) : dossier sur la machine hôte et rétention en jours (docs/admin/exploitation.md)
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
# reverse proxy nginx du profil proxy : dossier des certificats (fullchain.pem, privkey.pem)
CERTS_DIR=./certs
# vide = pas de nginx ; proxy = nginx fourni (une seule stack par machine, ports 80 et 443). En ligne de commande, l'équivalent est
# docker compose --profile proxy ; la prise en compte de cette variable par une stack Portainer est à vérifier sur votre Portainer
COMPOSE_PROFILES=
# fuseau horaire des conteneurs (coupure nocturne 03:00, date des sauvegardes)
TZ=Europe/Paris

# --- Pré-prod (docker-compose.dev.yml) : adresses qui pointent par défaut vers le bouchon mcp-stub. Pour brancher un vrai système,
# renseigner la vraie adresse (une valeur vide garde le bouchon). Sans objet en production (docker-compose.prod.yml n'a pas ces défauts).
# navigateur des collaborateurs → mires du bouchon : http://mcp-stub:4000=>http://<hôte-préprod>:4000 (localhost sur Docker Desktop)
BROWSER_URL_REWRITE=
# Microsoft réel (SharePoint et SSO Entra) : https://login.microsoftonline.com et https://graph.microsoft.com/v1.0
MS_LOGIN_URL=
GRAPH_URL=
# Dropbox réel : https://www.dropbox.com, https://api.dropboxapi.com, https://mcp.dropbox.com/mcp
DROPBOX_AUTH_URL=
DROPBOX_API_URL=
DROPBOX_MCP_URL=
# port publié du bouchon et durée de vie de ses jetons simulés (minutes), pour exercer le renouvellement automatique
STUB_PORT=4000
STUB_TOKEN_TTL_MIN=10
# SSO du portail : vide (pas de SSO), entra (Microsoft Entra ID réel : MS_TENANT_ID = GUID de l'annuaire, MS_CLIENT_ID et
# MS_CLIENT_SECRET de l'application SharePoint, URI de redirection <PUBLIC_URL>/auth/sso/callback) ou mock (mire du bouchon,
# interdit en production). Voir docs/admin/sso-entra.md.
SSO_MODE=

# Salesforce — serveur MCP hébergé « SObject Reads » (Configuration → Serveurs MCP → URL du serveur) et External Client App
# (OAuth activé, scopes « Access Salesforce hosted MCP servers » + « Perform requests at any time », PKCE, jetons JWT,
# callback <PUBLIC_URL>/auth/salesforce/callback). Vide = bouchon en pré-prod.
# SF_LOGIN_URL = My Domain : https://charloisgroup.my.salesforce.com, ou https://charloisgroup--<nom>.sandbox.my.salesforce.com
SF_LOGIN_URL=
SF_MCP_URL=
SF_CLIENT_ID=
# vide si l'External Client App n'exige pas de secret
SF_CLIENT_SECRET=
# défaut : mcp_api refresh_token ; ajouter openid si l'app l'autorise (affiche l'email)
SF_SCOPE=
# LIMIT ajouté d'office aux requêtes SOQL qui n'en ont pas, sauf les agrégats COUNT(), SUM(), GROUP BY… (défaut 200, 0 = désactivé)
SF_DEFAULT_LIMIT=
# plafond d'appels vers le serveur MCP Salesforce par minute, tous utilisateurs confondus (crédits Flex ; défaut 0 = illimité)
SF_MAX_PER_MIN=

# Sage X3 24R1 — vide = bouchon en pré-prod (compose de base : simulateur interne YFAC, YCLIENT, ZVENTE)
# Instance réelle : SAGE_URL = racine Syracuse (ex. https://x3-test-ext-….4cadcloud2.com), SAGE_FOLDER = NOM du point de
# connexion (colonne « Nom » de la liste Points de connexion, ex. X3TST_CHREC), pas l'intitulé ni le dossier X3.
SAGE_URL=
SAGE_FOLDER=
# représentations exposées (le diagnostic signale celles absentes du dossier) ; défaut : les 8 standards ci-dessous
SAGE_REPRESENTATIONS=BPCUSTOMER,BPSUPPLIER,SINVOICE,PINVOICE,SORDER,PORDER,GACCENTRY,ITMMASTER
# langue des libellés renvoyés par Syracuse (défaut fr-FR)
SAGE_LANG=
# bearer (défaut : coller seulement la clé) ou basic (login Syracuse + mot de passe, vérifié sur 24R1)
SAGE_APIKEY_MODE=
# OAuth Sage X3, optionnel (non vérifié) : à décommenter seulement avec un serveur OAuth2 déclaré dans Syracuse. Le mode vérifié
# est SAGE_APIKEY_MODE=basic. Pré-prod (docker-compose.dev.yml) : lignes absentes = IdP simulé du bouchon ; lignes présentes et
# vides = pas d'OAuth, le portail demande l'identifiant et le mot de passe Syracuse (à faire avec un vrai SAGE_URL).
#SAGE_OAUTH_AUTH_URL=
#SAGE_OAUTH_TOKEN_URL=
#SAGE_OAUTH_USERINFO_URL=
#SAGE_OAUTH_CLIENT_ID=
#SAGE_OAUTH_CLIENT_SECRET=
# avec Entra ID : openid offline_access api://<app-id-syracuse>/.default
#SAGE_OAUTH_SCOPE=

# SharePoint / OneDrive — app Entra ID, permissions déléguées lecture (callback <PUBLIC_URL>/auth/sharepoint/callback)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
SP_SITE=

# Dropbox — app Dropbox (scopes account_info.read, files.metadata.read, files.content.read, sharing.read)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# MyReport — URL SSE du serveur MCP de votre MyReport Server (vide = bouchon en pré-prod, simulateur interne sinon)
MYREPORT_MCP_URL=
MYREPORT_AUTH_HEADER=
# liste blanche (lecture seule) des outils à transférer, d'après le bouton « Tester MyReport »
MYREPORT_TOOLS=
# MyReport n'a qu'une production : plafond d'appels sortants par minute, tous utilisateurs confondus (défaut 20, 0 = illimité)
MYREPORT_MAX_PER_MIN=

# Clevoa — clé client de licence ; télémétrie réduite à des compteurs, au démarrage puis toutes les 6 heures (vide = désactivée)
CLEVOA_KEY=
CLEVOA_URL=

# --- État des systèmes et supervision (docs/admin/exploitation.md § 11)
# vérification de joignabilité des systèmes (HEAD sans identifiant) : vide = toutes les 10 min du lundi au vendredi de 7 h à 19 h ; off ; always
PROBE=
# temps de réponse p95 en millisecondes au-delà duquel le portail affiche « Lent » (défaut 10000)
SLOW_MS=
# jeton de la supervision (Zabbix, PRTG, Centreon, Prometheus…) pour GET /metrics : openssl rand -hex 24 ; vide = route désactivée
METRICS_TOKEN=
# classement des applications sur le portail, ex. sagex3=industrie (commerce, finance, industrie, documents, rh, autre)
CONNECTOR_DOMAINS=

# --- Journal d'audit (docs/admin/securite.md § 7) : désactivé par défaut ; à activer après avis du DPO et information des collaborateurs
# on = chaque appel d'outil journalisé (collaborateur, système, outil, résultat, durée ; jamais les arguments ni les données)
AUDIT=
# durée de conservation du journal d'audit en jours (défaut 90)
AUDIT_DAYS=
