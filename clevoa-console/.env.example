# Copier en .env à côté de docker-compose.yml (ce fichier .env ne doit jamais être commité).
# Utilisateur IAM dédié à la console, avec la seule politique clevoa-backend-prod-console-lecture
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
TELEMETRY_TABLE=clevoa-backend-prod-installations
# mot de passe demandé par le navigateur (l'identifiant saisi est libre)
CONSOLE_PASSWORD=
CONSOLE_PORT=8090
MIN_VERSION=
