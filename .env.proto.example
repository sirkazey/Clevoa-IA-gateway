# Prototype « connexion en un clic » : copier en .env.proto (jamais commité), remplir, puis
#   docker compose -f docker-compose.proto.yml --env-file .env.proto up -d --build
# Guide pas à pas : docs/etudes/prototype-un-clic.md

# Nom public du prototype (sous-domaine de la zone Cloudflare) et jeton du tunnel
PROTO_HOST=mcp-proto.socle.si
CLOUDFLARE_TUNNEL_TOKEN=

# Clé maîtresse du store du prototype : openssl rand -hex 32 (propre au prototype, jamais celle d'une autre installation)
ENCRYPTION_KEY=

# Portail en local seulement
PUBLIC_URL=http://localhost:8080
HUB_PORT=127.0.0.1:8080

# Annuaires réels (étape 2 du guide). Laisser vide = annuaire simulé par le bouchon.
# Entra Charlois : application inscrite dans l'annuaire de Charlois, URI de redirection https://<PROTO_HOST>/oauth/callback/charlois
OIDC_CHARLOIS_ISSUER=
OIDC_CHARLOIS_CLIENT_ID=
OIDC_CHARLOIS_CLIENT_SECRET=
OIDC_CHARLOIS_DOMAINS=
# Entra Oakwood Cooperage (autre annuaire) : URI de redirection https://<PROTO_HOST>/oauth/callback/oakwood
OIDC_OAKWOOD_ISSUER=
OIDC_OAKWOOD_CLIENT_ID=
OIDC_OAKWOOD_CLIENT_SECRET=
OIDC_OAKWOOD_DOMAINS=
# Google Workspace de la société acquise : URI de redirection https://<PROTO_HOST>/oauth/callback/acquise
OIDC_ACQUISE_ISSUER=
OIDC_ACQUISE_CLIENT_ID=
OIDC_ACQUISE_CLIENT_SECRET=
OIDC_ACQUISE_DOMAINS=acquise.example

# N'afficher que certains annuaires, dans cet ordre (ex. charlois seul pour commencer)
OIDC_PROVIDERS=charlois,oakwood,acquise
